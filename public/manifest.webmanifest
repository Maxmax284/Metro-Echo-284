{
  "id": "/",
  "lang": "en",
  "name": "Metro Echo — situational companion",
  "short_name": "Metro Echo",
  "description": "Metro Echo is a situational companion for real life: place, movement, messages and documents read in context, with nothing acting on its own.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0c1014",
  "theme_color": "#0c1014",
  "categories": [
    "productivity",
    "utilities"
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "text/*",
            ".doc",
            ".docx",
            ".xls",
            ".xlsx",
            ".csv",
            ".heic"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "What needs me?",
      "short_name": "Today",
      "url": "/?room=today",
      "description": "Open Today and see what actually needs you."
    },
    {
      "name": "Ask Echo",
      "short_name": "Ask",
      "url": "/?room=ask",
      "description": "Open Ask and put the situation in your own words."
    },
    {
      "name": "Receipts",
      "short_name": "Receipts",
      "url": "/?room=receipts",
      "description": "Open Receipts and see what happened and why."
    },
    {
      "name": "Flights",
      "short_name": "Flights",
      "url": "/flights",
      "description": "Open the flight board for a filed journey."
    }
  ]
}